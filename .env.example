# ---------------------------------------------------------------------------
# Al-Anwaar platform server. Copy to .env and fill in what you have.
# Everything is optional in development: with nothing set, the server runs an
# embedded MongoDB under .data/, keeps email in the admin portal's outbox, and
# simulates card payments.
#
# PRODUCTION (NODE_ENV=production) refuses to start without JWT_SECRET,
# APP_URL, MONGODB_URI, SMTP_HOST, a live STRIPE_SECRET_KEY (sk_live_) and
# STRIPE_WEBHOOK_SECRET — unless ALLOW_SIMULATED_PAYMENTS=1 (staging only).
#
# The server always keeps time in Australia/Sydney (server/env.ts sets TZ).
# ---------------------------------------------------------------------------

PORT=4600
# The public URL of the site, used in emailed links
APP_URL=http://localhost:5190
# Long random string. REQUIRED in production.
JWT_SECRET=

# MongoDB Atlas connection string. Empty = embedded dev database in .data/mongo
MONGODB_URI=

# Email. Empty SMTP_HOST = every email is kept in Admin > Email log instead of sent.
# For Amazon SES use its SMTP endpoint, e.g. email-smtp.ap-southeast-2.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments. Empty = simulated (card ending 0002 declines, anything else succeeds).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the PayPal webhook pointing at /api/webhooks/paypal (events
# PAYMENT.CAPTURE.*). Required in production when PayPal is connected.
PAYPAL_WEBHOOK_ID=
# Sandbox in development; production requires (and defaults to) the live
# endpoint, https://api-m.paypal.com
PAYPAL_API=https://api-m.sandbox.paypal.com

# Files. Empty S3_BUCKET = files are stored on disk under .data/uploads
S3_BUCKET=
S3_REGION=ap-southeast-2

# Donor sign-in with Google / Facebook. Empty = the buttons are not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Set to 1 to wipe and re-seed the development database on start
SEED_RESET=
# Production only: 1 seeds the invented demo data into an EMPTY database (staging).
# Refused unless ALLOW_SIMULATED_PAYMENTS=1; with it off, production will not start
# while any staff login still uses the demo password.
SEED_DEMO=
# Check new staff passwords against Have I Been Pwned (only a 5-character hash
# prefix is sent). Empty = on in production, off elsewhere; 1 or 0 to force.
PWNED_CHECK=
# Proxies in front of the API: 1 behind one load balancer, 2 behind Vercel + Render
TRUST_PROXY=

# STAGING ONLY: 1 lets a production build run with simulated payments and no
# SMTP. Simulated gifts are marked and never get a real tax receipt.
ALLOW_SIMULATED_PAYMENTS=
# Shared with the site's host: when set, /api answers only requests carrying it
# in X-Origin-Auth, which Vercel's middleware.ts adds. Set the same value on
# Vercel, with API_ORIGIN (the API's address) there too.
ORIGIN_SECRET=
# 0 turns the background jobs off in this process (a replica, a test run).
# Otherwise the jobs run in whichever process holds the lease in MongoDB.
RUN_JOBS=
# Two-step sign-in (an authenticator app) for owner, admin and finance staff.
# On by default in production, off in development; 1 or 0 to force it.
REQUIRE_STAFF_MFA=
# The key two-step sign-in secrets are sealed with. Empty = derived from JWT_SECRET,
# which then can't be rotated without breaking every enrolment. Set it before go-live
# (any long random string); existing enrolments keep working when it is added.
MFA_KEY=
# Tests only: 1 applies the production rate limits outside production.
STRICT_LIMITS=
